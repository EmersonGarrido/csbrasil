---
// /mapas — página de conteúdo indexável das arenas.
// Mesmo racional de /armas: nome de mapa é busca própria ("ferro velho",
// "piscina da treta") e o texto só existia dentro do JS do jogo.
//
// PASSAGEM DE VERDADE (05/08/2026). Três coisas mentiam aqui, e as três vinham
// de texto escrito à mão em vez de derivado do dado:
//   · a lista de arenas (a "Praça (clássico)" saiu do jogo, a Quebrada entrou —
//     ver o cabeçalho de src/data/jogo.ts);
//   · "Três abrem em rounds e duas em CTF" — é 2 e 3 desde que a Quebrada entrou.
//     Agora os dois números são CONTADOS de `MAPAS[].ctf`, não digitados;
//   · "respawn de 2,5 s" — `public/js/game.js:76` diz `RESPAWN_DELAY = 2.2`, e a
//     /como-jogar já tinha sido corrigida em 04/08. Esta ficou pra trás.
// Junto: "4×4" não é fixo, é o PADRÃO (`settings.bots`, public/js/main.js:18,
// aceita de 1 a 8 por lado).
import Layout from '../layouts/Layout.astro';
import { MAPAS } from '../data/jogo';
import { BRAND_FULL, GAME_ID, abs } from '../lib/site';

const nCtf = MAPAS.filter(m => m.ctf).length;
const nRounds = MAPAS.length - nCtf;
const plural = (n: number, um: string, muitos: string) => (n === 1 ? um : muitos);

const jsonld = [
  {
    '@type': 'ItemList',
    '@id': abs('/mapas') + '#lista',
    name: `Mapas do ${BRAND_FULL}`,
    numberOfItems: MAPAS.length,
    itemListElement: MAPAS.map((m, i) => ({
      '@type': 'ListItem', position: i + 1, name: m.nome, description: m.resumo,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Mapas', item: abs('/mapas') },
    ],
  },
  { '@id': GAME_ID },
];
---
<Layout
  title={`Mapas — as ${MAPAS.length} arenas | ${BRAND_FULL}`}
  description={`As ${MAPAS.length} arenas do ${BRAND_FULL}: ${MAPAS.map(m => m.nome).join(', ')} — layout, modo e como jogar cada uma.`}
  jsonld={jsonld}>

  <h1>Mapas</h1>
  <p class="sub">
    {MAPAS.length} arenas jogáveis. {nRounds} {plural(nRounds, 'abre', 'abrem')} em rounds e
    {' '}{nCtf} {plural(nCtf, 'abre', 'abrem')} em Capture the Flag — mas nenhuma trava o modo:
    dá pra jogar qualquer mapa em qualquer modo pelo menu antes da partida.
  </p>

  <div class="grid c2">
    {MAPAS.map(m => (
      <article class="panel">
        <h3 style="margin-top:0">{m.nome}</h3>
        <span class="chip">{m.modo}</span>
        <span class="chip" style="margin-left:6px"><code style="background:none;padding:0">{m.id}</code></span>
        <p style="margin-top:10px;color:var(--bone)">{m.resumo}</p>
        <p style="margin-top:8px;font-size:13px">{m.detalhe}</p>
      </article>
    ))}
  </div>

  <h2>Rounds ou CTF</h2>
  <ul>
    <li><strong>Rounds:</strong> 4×4 por padrão (o menu vai de 1 a 8 por lado), com respawn de
      2,2 s. Round de 1:39; leva o round o time com mais abates quando o relógio zera; 3 rounds
      vencem a partida, e a 5ª rodada é o teto.</li>
    <li><strong>Capture the Flag:</strong> quatro bandeiras espalhadas pela arena. A geometria da
      Loja H, do Ferro Velho e da Quebrada foi desenhada em volta delas — por isso os três abrem
      em CTF. Em CTF a rodada acaba por captura, não por relógio.</li>
    <li>O mapa é sorteado ou escolhido na tela de seleção, antes de começar.</li>
  </ul>

  <p style="margin-top:26px"><a class="btn-play" style="margin-left:0;display:inline-block" href="/">▶ Entrar na arena</a></p>
</Layout>
