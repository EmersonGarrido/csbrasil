<meta charset="UTF-8">
<!-- Captura de crash: mostra o erro NA TELA. O jogo "fechava sozinho" e o erro sumia do
     console; este overlay persiste a exceção (JS) pra o usuário printar. Script clássico
     inline roda ANTES dos módulos (deferidos), então pega até erro em tempo de execução
     dos módulos. Crash de GPU/renderer não dispara 'error' — pra esse caso use ?bloom=0. -->
<script is:inline>
(function(){
  function show(kind, msg, extra){
    try{
      var el = document.getElementById('crash-overlay');
      if(!el){
        el = document.createElement('div'); el.id = 'crash-overlay';
        el.style.cssText = 'position:fixed;left:0;right:0;bottom:0;max-height:45vh;overflow:auto;z-index:2147483647;background:rgba(120,0,0,.94);color:#fff;font:12px/1.45 ui-monospace,Menlo,monospace;padding:10px 14px;white-space:pre-wrap;border-top:2px solid #ff5252';
        el.onclick = function(){ el.remove(); };
        (document.body || document.documentElement).appendChild(el);
      }
      el.textContent = '⚠ CRASH (' + kind + '): ' + msg + (extra ? ('\n\n' + extra) : '') + '\n\n(clique pra fechar — tire um print e me mande)';
    }catch(_){}
  }
  window.addEventListener('error', function(e){
    var loc = e.filename ? (e.filename + ':' + e.lineno + ':' + e.colno) : '';
    show('error', ((e.message || e.error || '?')) + (loc ? ('  @ ' + loc) : ''), e.error && e.error.stack);
  });
  window.addEventListener('unhandledrejection', function(e){
    var r = e.reason; show('promise', (r && r.message) || String(r), r && r.stack);
  });
})();
</script>
