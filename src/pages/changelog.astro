---
// /changelog — o CHANGELOG.md renderizado como página.
//
// O arquivo é lido do disco em BUILD TIME (a página é estática), então nenhuma
// dependência de markdown entra no bundle e nenhum request extra acontece em
// produção. O renderizador abaixo cobre exatamente o subconjunto de Markdown que
// o CHANGELOG usa hoje — headings, listas, negrito, itálico, código e link —
// e ESCAPA HTML antes de qualquer coisa, então conteúdo do arquivo nunca vira
// marcação executável. Não é um parser de Markdown de propósito: instalar `marked`
// exigiria rede, e o ganho seria zero pro que este arquivo precisa.
import Layout from '../layouts/Layout.astro';
import { BRAND_FULL, GAME_ID, abs } from '../lib/site';

/* `?raw` (Vite) e NÃO `readFileSync(new URL('../../CHANGELOG.md', import.meta.url))`.
   Os dois parecem "ler em build time", mas só este é.

   O que quebrava: no build, esta página vira um chunk em
   `dist/server/.prerender/chunks/changelog_*.mjs`. `import.meta.url` passa a apontar
   para ALI, então a URL relativa resolvia para `dist/server/CHANGELOG.md` — que não
   existe — e o prerender morria com ENOENT, derrubando o build inteiro:

     [ERROR] ENOENT: no such file or directory, open '.../dist/server/CHANGELOG.md'

   Ninguém tinha visto porque `npm run build` nunca havia rodado nesta árvore
   (era o item B1 do HANDOFF). Com `?raw` o conteúdo é embutido no bundle pelo Vite:
   não há caminho para resolver em runtime, e o deploy não depende de o .md estar lá. */
import md from '../../CHANGELOG.md?raw';

const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// inline: `code`, **negrito**, _itálico_, [texto](url)
function inline(s: string): string {
  return esc(s)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/(^|[^\w*])\*([^*\n]+)\*/g, '$1<em>$2</em>')
    .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" rel="noopener">$1</a>');
}

interface Versao { versao: string; data: string; html: string }

const versoes: Versao[] = [];
let atual: { versao: string; data: string; linhas: string[] } | null = null;

for (const raw of md.split('\n')) {
  const h2 = raw.match(/^##\s+\[?([^\]\s]+)\]?\s*(?:—|-)?\s*(.*)$/);
  if (h2) {
    if (atual) versoes.push({ versao: atual.versao, data: atual.data, html: render(atual.linhas) });
    atual = { versao: h2[1], data: h2[2].trim(), linhas: [] };
    continue;
  }
  if (atual) atual.linhas.push(raw);
}
if (atual) versoes.push({ versao: atual.versao, data: atual.data, html: render(atual.linhas) });

function render(linhas: string[]): string {
  const out: string[] = [];
  let emLista = false;
  const fechaLista = () => { if (emLista) { out.push('</ul>'); emLista = false; } };
  for (const l of linhas) {
    const h3 = l.match(/^###\s+(.*)$/);
    if (h3) { fechaLista(); out.push(`<h3>${inline(h3[1])}</h3>`); continue; }
    const li = l.match(/^\s*[-*]\s+(.*)$/);
    if (li) {
      if (!emLista) { out.push('<ul>'); emLista = true; }
      out.push(`<li>${inline(li[1])}</li>`);
      continue;
    }
    if (!l.trim()) { fechaLista(); continue; }
    // continuação de item de lista (o CHANGELOG quebra linha dentro do bullet)
    if (emLista) { out[out.length - 1] = out[out.length - 1].replace(/<\/li>$/, ' ' + inline(l.trim()) + '</li>'); continue; }
    out.push(`<p>${inline(l.trim())}</p>`);
  }
  fechaLista();
  return out.join('\n');
}

const recentes = versoes.slice(0, 12);
const atualVer = versoes[0]?.versao ?? '';

const jsonld = [
  {
    '@type': 'ItemList',
    '@id': abs('/changelog') + '#lista',
    name: `Histórico de versões do ${BRAND_FULL}`,
    numberOfItems: recentes.length,
    itemListElement: recentes.map((v, i) => ({
      '@type': 'ListItem', position: i + 1, name: `v${v.versao}`,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: 'Changelog', item: abs('/changelog') },
    ],
  },
  { '@id': GAME_ID, softwareVersion: atualVer },
];
---
<Layout
  title={`Changelog — o que mudou (v${atualVer}) | ${BRAND_FULL}`}
  description={`Histórico de versões do ${BRAND_FULL}: novas facções, mapas, armas, ajustes de viewmodel, bots e correções, versão por versão.`}
  jsonld={jsonld}>

  <h1>Changelog</h1>
  <p class="sub">
    Tudo que mudou, versão por versão. A versão em produção é a <strong>v{atualVer}</strong>.
    O arquivo completo vive em <code>CHANGELOG.md</code> no repositório — esta página é ele,
    renderizado.
  </p>

  {recentes.map((v, i) => (
    <details open={i < 2}>
      <summary>
        <strong>v{v.versao}</strong>
        {v.data && <span style="color:var(--bone-dim);font-size:11px;letter-spacing:2px"> · {v.data}</span>}
      </summary>
      <div class="cl" set:html={v.html} />
    </details>
  ))}

  {versoes.length > recentes.length && (
    <p style="margin-top:18px">
      Versões anteriores à v{recentes[recentes.length - 1].versao} estão no
      <a href="https://github.com/rubenmarcus/csbrasil/blob/main/CHANGELOG.md" rel="noopener"> CHANGELOG.md</a>.
    </p>
  )}
</Layout>

<style is:global>
.cl h3{margin:16px 0 6px;color:var(--amber);font-size:12px}
.cl ul{margin:4px 0 4px 4px}
.cl li{font-size:13px;line-height:1.55}
.cl p{font-size:13px;margin:6px 0}
</style>
